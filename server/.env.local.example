# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database (XAMPP Local MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=portfolio
DB_SSL=false

# Auth
JWT_SECRET=change_me_to_a_long_random_string_for_local_dev
JWT_EXPIRES_IN=7d
ADMIN_EMAIL=admin@localhost.com
ADMIN_PASSWORD=admin123

# ImageKit (use your own credentials)
IMAGEKIT_PUBLIC_KEY=public_xxx
IMAGEKIT_PRIVATE_KEY=private_xxx
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_id

# SMTP (configure for local testing or use MailHog)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM="TK Portfolio <noreply@localhost>"
ADMIN_NOTIFY_EMAIL=admin@localhost.com